<!DOCTYPE html>
<html lang="en" data-theme="moonlight" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "Domex - Local Smart Home Hub"}</title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <link
      phx-track-static
      rel="stylesheet"
      href={
        DuskmoonBundler.static_path(DomexWeb.Endpoint, "/assets/css/app.css",
          profile: :domex_web,
          outdir: "priv/static/assets"
        )
      }
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={DuskmoonBundler.static_path(DomexWeb.Endpoint, "/assets/app.js")}
    >
    </script>
  </head>
  <body class="h-full antialiased bg-surface text-on-surface">
    {@inner_content}
  </body>
</html>
