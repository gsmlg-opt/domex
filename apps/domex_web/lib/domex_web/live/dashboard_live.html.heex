<Layouts.app flash={@flash}>
  <div class="space-y-8">
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-outline-variant">
      <div>
        <h1 class="text-3xl font-black tracking-tight flex items-center gap-2 text-on-surface">
          <span>Smart Home</span>
          <.dm_badge variant="primary" size="sm" pill>Local</.dm_badge>
        </h1>
        <p class="text-sm text-on-surface-variant mt-0.5">
          {map_size(@devices)} configured devices &bull; {Enum.count(
            Map.values(@devices),
            & &1.online?
          )} online
        </p>
      </div>

      <div class="flex items-center gap-2">
        <.dm_btn
          phx-click="trigger_discovery"
          variant="outline"
          size="sm"
          title="Scan local network for devices"
          class="gap-1.5"
        >
          <.dm_mdi name="magnify" class="size-4 motion-safe:animate-pulse" />
          <span>Discover</span>
        </.dm_btn>

        <.dm_btn
          phx-click="open_add_modal"
          variant="primary"
          size="sm"
          class="gap-1.5"
        >
          <.dm_mdi name="plus" class="size-4" />
          <span>Add Device</span>
        </.dm_btn>
      </div>
    </div>
    
<!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <.dm_stat title="Total Devices" value={to_string(map_size(@devices))} />
      <.dm_stat
        title="Online"
        value={to_string(Enum.count(Map.values(@devices), & &1.online?))}
      />
      <.dm_stat
        title="Offline"
        value={to_string(Enum.count(Map.values(@devices), &(!&1.online?)))}
      />
      <.dm_stat title="Discovered" value={to_string(map_size(@discovered))} />
    </div>
    
<!-- Discovered Devices Banner -->
    <%= if map_size(@discovered) > 0 do %>
      <.dm_card variant="bordered" class="bg-primary/10 border-primary/30 p-4 space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-primary font-bold text-sm">
            <.dm_mdi name="auto-fix" class="size-5" />
            <span>Discovered {map_size(@discovered)} New Device(s) on Local Network</span>
          </div>
          <span class="text-xs text-on-surface-variant">Auto-detected via UDP broadcast</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <%= for {id, meta} <- @discovered do %>
            <div class="flex items-center justify-between bg-surface rounded-xl p-3 border border-outline-variant shadow-xs">
              <div class="truncate mr-2">
                <div class="font-semibold text-sm truncate text-on-surface">
                  {meta[:name] || meta["name"] || id}
                </div>
                <div class="text-xs text-on-surface-variant font-mono">
                  {meta[:host] || meta["host"]}:{meta[:port] || meta["port"]}
                </div>
              </div>
              <.dm_btn
                phx-click="add_discovered"
                phx-value-id={id}
                variant="primary"
                size="xs"
                class="shrink-0"
              >
                Connect
              </.dm_btn>
            </div>
          <% end %>
        </div>
      </.dm_card>
    <% end %>
    
<!-- Empty State -->
    <%= if map_size(@devices) == 0 do %>
      <.dm_card
        variant="bordered"
        class="text-center py-16 px-4 space-y-4 border-dashed border-outline-variant"
      >
        <div class="size-16 bg-surface-container-high rounded-full flex items-center justify-center mx-auto text-on-surface-variant">
          <.dm_mdi name="home-outline" class="size-8" />
        </div>
        <div>
          <h3 class="text-lg font-bold text-on-surface">No devices configured yet</h3>
          <p class="text-sm text-on-surface-variant max-w-sm mx-auto mt-1">
            Scan your local network to discover Yeelight, Xiaomi miIO, and Midea appliances automatically, or add one manually.
          </p>
        </div>
        <div class="flex justify-center gap-3 pt-2">
          <.dm_btn phx-click="trigger_discovery" variant="outline" size="sm">
            Scan Network
          </.dm_btn>
          <.dm_btn phx-click="open_add_modal" variant="primary" size="sm">
            Add Manually
          </.dm_btn>
        </div>
      </.dm_card>
    <% end %>
    
<!-- Lighting Section -->
    <% lights = Enum.filter(Map.values(@devices), &(&1.type == :light)) %>
    <%= if length(lights) > 0 do %>
      <section class="space-y-3">
        <div class="flex items-center gap-2">
          <.dm_mdi name="lightbulb-outline" class="size-5 text-warning" />
          <h2 class="text-xl font-bold tracking-tight text-on-surface">Lighting</h2>
          <.dm_badge variant="secondary" size="xs">{length(lights)}</.dm_badge>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= for device <- lights do %>
            <div class="relative group">
              <.link
                navigate={~p"/devices/#{device.id}"}
                class="absolute top-4 right-16 p-2 text-on-surface-variant hover:text-on-surface z-10"
                title="Device Details"
              >
                <.dm_mdi name="cog-outline" class="size-4" />
              </.link>
              <.light_control shadow={device} />
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
    
<!-- Climate Section -->
    <% climates = Enum.filter(Map.values(@devices), &(&1.type == :climate)) %>
    <%= if length(climates) > 0 do %>
      <section class="space-y-3">
        <div class="flex items-center gap-2">
          <.dm_mdi name="air-conditioner" class="size-5 text-info" />
          <h2 class="text-xl font-bold tracking-tight text-on-surface">Climate & Heating</h2>
          <.dm_badge variant="secondary" size="xs">{length(climates)}</.dm_badge>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= for device <- climates do %>
            <div class="relative group">
              <.link
                navigate={~p"/devices/#{device.id}"}
                class="absolute top-4 right-16 p-2 text-on-surface-variant hover:text-on-surface z-10"
                title="Device Details"
              >
                <.dm_mdi name="cog-outline" class="size-4" />
              </.link>
              <.ac_control shadow={device} />
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
    
<!-- Switches Section -->
    <% switches = Enum.filter(Map.values(@devices), &(&1.type in [:switch, :sensor])) %>
    <%= if length(switches) > 0 do %>
      <section class="space-y-3">
        <div class="flex items-center gap-2">
          <.dm_mdi name="power" class="size-5 text-success" />
          <h2 class="text-xl font-bold tracking-tight text-on-surface">Switches & Plugs</h2>
          <.dm_badge variant="secondary" size="xs">{length(switches)}</.dm_badge>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= for device <- switches do %>
            <div class="relative group">
              <.link
                navigate={~p"/devices/#{device.id}"}
                class="absolute top-4 right-16 p-2 text-on-surface-variant hover:text-on-surface z-10"
                title="Device Details"
              >
                <.dm_mdi name="cog-outline" class="size-4" />
              </.link>
              <.generic_switch shadow={device} />
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
    
<!-- Other Section -->
    <% others =
      Enum.filter(Map.values(@devices), &(&1.type not in [:light, :climate, :switch, :sensor])) %>
    <%= if length(others) > 0 do %>
      <section class="space-y-3">
        <div class="flex items-center gap-2">
          <.dm_mdi name="chip" class="size-5 text-primary" />
          <h2 class="text-xl font-bold tracking-tight text-on-surface">Other Devices</h2>
          <.dm_badge variant="secondary" size="xs">{length(others)}</.dm_badge>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= for device <- others do %>
            <div class="relative group">
              <.link
                navigate={~p"/devices/#{device.id}"}
                class="absolute top-4 right-16 p-2 text-on-surface-variant hover:text-on-surface z-10"
                title="Device Details"
              >
                <.dm_mdi name="cog-outline" class="size-4" />
              </.link>
              <.generic_switch shadow={device} />
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
  
<!-- Add Device Modal -->
  <%= if @show_add_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
      <.dm_card
        variant="bordered"
        class="w-full max-w-md p-6 space-y-5 bg-surface text-on-surface shadow-2xl"
      >
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-on-surface">Add Smart Device</h3>
          <.dm_btn phx-click="close_add_modal" variant="ghost" size="sm" shape="circle">
            <.dm_mdi name="close" class="size-5" />
          </.dm_btn>
        </div>

        <.form for={@new_device_form} phx-submit="save_device" class="space-y-4">
          <div class="space-y-1">
            <label class="text-xs font-semibold text-on-surface-variant">Device Name</label>
            <input
              type="text"
              name="device[name]"
              required
              placeholder="Living Room Lamp"
              class="w-full rounded-lg border border-outline-variant bg-surface-container px-3 py-2 text-sm text-on-surface focus:outline-hidden focus:ring-2 focus:ring-primary"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-on-surface-variant">Category</label>
              <select
                name="device[type]"
                class="w-full rounded-lg border border-outline-variant bg-surface-container px-3 py-2 text-sm text-on-surface focus:outline-hidden focus:ring-2 focus:ring-primary"
              >
                <option value="light">Light</option>
                <option value="climate">Climate (AC)</option>
                <option value="switch">Switch / Plug</option>
              </select>
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-on-surface-variant">Adapter</label>
              <select
                name="device[adapter]"
                class="w-full rounded-lg border border-outline-variant bg-surface-container px-3 py-2 text-sm text-on-surface focus:outline-hidden focus:ring-2 focus:ring-primary"
              >
                <option value="Domex.Adapter.YeelightLan">Yeelight LAN (TCP 55443)</option>
                <option value="Domex.Adapter.MiioDevice">Xiaomi miIO (UDP 54321)</option>
                <option value="Domex.Adapter.MideaDevice">Midea AC (TCP 6444)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="col-span-2 space-y-1">
              <label class="text-xs font-semibold text-on-surface-variant">
                Host IP / Address
              </label>
              <input
                type="text"
                name="device[host]"
                required
                placeholder="192.168.1.100"
                class="w-full rounded-lg border border-outline-variant bg-surface-container px-3 py-2 text-sm font-mono text-on-surface focus:outline-hidden focus:ring-2 focus:ring-primary"
              />
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-on-surface-variant">Port</label>
              <input
                type="number"
                name="device[port]"
                placeholder="Default"
                class="w-full rounded-lg border border-outline-variant bg-surface-container px-3 py-2 text-sm font-mono text-on-surface focus:outline-hidden focus:ring-2 focus:ring-primary"
              />
            </div>
          </div>

          <div class="space-y-1">
            <label class="text-xs font-semibold text-on-surface-variant">
              Token (for miIO / encrypted protocols)
            </label>
            <input
              type="text"
              name="device[token]"
              placeholder="32-char hex string (optional for Yeelight/Midea)"
              class="w-full rounded-lg border border-outline-variant bg-surface-container px-3 py-2 text-xs font-mono text-on-surface focus:outline-hidden focus:ring-2 focus:ring-primary"
            />
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <.dm_btn type="button" phx-click="close_add_modal" variant="ghost">
              Cancel
            </.dm_btn>
            <.dm_btn type="submit" variant="primary">
              Save & Connect
            </.dm_btn>
          </div>
        </.form>
      </.dm_card>
    </div>
  <% end %>
</Layouts.app>
