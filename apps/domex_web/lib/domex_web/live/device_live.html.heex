<Layouts.app flash={@flash}>
  <div class="space-y-6">
    <!-- Breadcrumb & Navigation -->
    <div class="flex items-center justify-between pb-3 border-b border-outline-variant">
      <div class="flex items-center gap-2 text-sm">
        <.link
          navigate={~p"/"}
          class="text-on-surface-variant hover:text-primary flex items-center gap-1"
        >
          <.dm_mdi name="arrow-left" class="size-4" />
          <span>Dashboard</span>
        </.link>
        <span class="text-on-surface-variant">/</span>
        <span class="font-bold text-on-surface">{@shadow.name}</span>
      </div>

      <.dm_btn
        phx-click="delete_device"
        phx-value-id={@shadow.id}
        data-confirm="Are you sure you want to remove this device?"
        variant="error"
        size="xs"
        class="gap-1"
      >
        <.dm_mdi name="delete-outline" class="size-3.5" />
        <span>Delete Device</span>
      </.dm_btn>
    </div>
    
<!-- Active Device Control Component -->
    <div>
      <%= cond do %>
        <% @shadow.type == :light -> %>
          <.light_control shadow={@shadow} />
        <% @shadow.type == :climate -> %>
          <.ac_control shadow={@shadow} />
        <% true -> %>
          <.generic_switch shadow={@shadow} />
      <% end %>
    </div>
    
<!-- Connection & Diagnostic Info -->
    <.dm_card variant="bordered" class="p-5 space-y-4">
      <h3 class="font-bold text-sm text-on-surface flex items-center gap-1.5 uppercase tracking-wider">
        <.dm_mdi name="information-outline" class="size-4 text-info" />
        <span>Device Information</span>
      </h3>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
        <div>
          <span class="text-xs text-on-surface-variant block">Status</span>
          <span class="mt-0.5 inline-block">
            <.dm_badge
              variant={if @shadow.online?, do: "success", else: "error"}
              size="xs"
              pill
            >
              {if @shadow.online?, do: "Online", else: "Offline"}
            </.dm_badge>
          </span>
        </div>

        <div>
          <span class="text-xs text-on-surface-variant block">Network Address</span>
          <span class="font-mono text-xs font-medium text-on-surface mt-0.5 block truncate">
            {@shadow.host}:{@shadow.port}
          </span>
        </div>

        <div>
          <span class="text-xs text-on-surface-variant block">Adapter Driver</span>
          <span class="font-mono text-xs font-medium text-on-surface mt-0.5 block truncate">
            {to_string(@shadow.adapter)}
          </span>
        </div>

        <div>
          <span class="text-xs text-on-surface-variant block">Category</span>
          <span class="capitalize text-xs font-medium text-on-surface mt-0.5 block">
            {@shadow.type}
          </span>
        </div>

        <div>
          <span class="text-xs text-on-surface-variant block">Device ID</span>
          <span class="font-mono text-xs text-on-surface-variant mt-0.5 block truncate">
            {@shadow.id}
          </span>
        </div>

        <div>
          <span class="text-xs text-on-surface-variant block">Last Update</span>
          <span class="text-xs text-on-surface-variant mt-0.5 block">
            {if @shadow.updated_at,
              do: Calendar.strftime(@shadow.updated_at, "%H:%M:%S UTC"),
              else: "Never"}
          </span>
        </div>
      </div>
    </.dm_card>
    
<!-- Raw Properties Inspector -->
    <%= if map_size(@shadow.properties) > 0 do %>
      <.dm_card variant="bordered" class="p-5 space-y-3">
        <h3 class="font-bold text-sm text-on-surface flex items-center gap-1.5 uppercase tracking-wider">
          <.dm_mdi name="code-tags" class="size-4 text-primary" />
          <span>Raw Device Properties</span>
        </h3>

        <div class="overflow-x-auto">
          <table class="w-full text-xs font-mono">
            <thead>
              <tr class="text-left text-on-surface-variant border-b border-outline-variant">
                <th class="pb-2">Property</th>
                <th class="pb-2">Value</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
              <%= for {k, v} <- @shadow.properties do %>
                <tr class="hover:bg-surface-container-high transition-colors">
                  <td class="py-1.5 font-bold text-primary">{to_string(k)}</td>
                  <td class="py-1.5 text-on-surface">{inspect(v)}</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </.dm_card>
    <% end %>
  </div>
</Layouts.app>
